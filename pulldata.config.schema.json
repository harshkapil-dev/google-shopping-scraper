{
  "fields": [
    {
      "key": "query",
      "label": "Product search query",
      "type": "text",
      "required": true,
      "placeholder": "stainless steel water bottle",
      "order": 1
    },
    {
      "key": "country",
      "label": "Shopping country",
      "type": "select",
      "required": false,
      "defaultValue": "US",
      "options": [
        {
          "label": "United States",
          "value": "US"
        },
        {
          "label": "United Kingdom",
          "value": "GB"
        },
        {
          "label": "Canada",
          "value": "CA"
        },
        {
          "label": "Australia",
          "value": "AU"
        },
        {
          "label": "Germany",
          "value": "DE"
        },
        {
          "label": "France",
          "value": "FR"
        },
        {
          "label": "India",
          "value": "IN"
        }
      ],
      "order": 2
    },
    {
      "key": "language",
      "label": "Search language",
      "type": "select",
      "required": false,
      "defaultValue": "en",
      "options": [
        {
          "label": "English",
          "value": "en"
        },
        {
          "label": "German",
          "value": "de"
        },
        {
          "label": "French",
          "value": "fr"
        }
      ],
      "order": 3
    },
    {
      "key": "max_total_results",
      "label": "Maximum results",
      "type": "number",
      "required": false,
      "defaultValue": 20,
      "min": 1,
      "max": 40,
      "order": 4
    }
  ],
  "resultsSchema": {
    "columns": [
      {
        "key": "position",
        "label": "Result position",
        "type": "integer"
      },
      {
        "key": "product_id",
        "label": "Google product ID",
        "type": "string"
      },
      {
        "key": "title",
        "label": "Product title",
        "type": "string"
      },
      {
        "key": "merchant",
        "label": "Merchant",
        "type": "string"
      },
      {
        "key": "price",
        "label": "Price",
        "type": "number"
      },
      {
        "key": "currency",
        "label": "Currency",
        "type": "string"
      },
      {
        "key": "rating",
        "label": "Rating",
        "type": "number"
      },
      {
        "key": "reviews",
        "label": "Review count",
        "type": "integer"
      },
      {
        "key": "seller_url",
        "label": "Merchant product URL",
        "type": "url"
      },
      {
        "key": "shopping_url",
        "label": "Google Shopping URL",
        "type": "url"
      },
      {
        "key": "image_url",
        "label": "Product image URL",
        "type": "url"
      },
      {
        "key": "sponsored",
        "label": "Sponsored",
        "type": "boolean"
      }
    ],
    "exportFormats": [
      "CSV",
      "JSON"
    ]
  }
}
